    {
      "name": "🔧 Admin - Categories",
      "description": "Admin category management endpoints. Requires ADMIN role.",
      "item": [
        {
          "name": "Get All Categories (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/categories",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "categories"]
            },
            "description": "Get all categories (admin view, includes inactive)."
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Latest gadgets and electronics\",\n  \"imageUrl\": \"https://example.com/electronics.jpg\",\n  \"displayOrder\": 1,\n  \"active\": true\n}"
            },
