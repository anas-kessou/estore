{
  "info": {
    "name": "E-Store Backend",
    "description": "Collection to test the E-Store Spring Boot backend (JWT auth, catalog, inventory, cart, orders, reviews, admin CSV import).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (USER) - set {{token}}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Public endpoint. Stores JWT token into collection variable {{token}} after response."
          },
          "response": [] ,
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let json = pm.response.json();",
                  "// Backend wraps responses into ApiResponse: { message, data, ... }",
                  "let token = json?.data?.token || json?.token || json?.data?.jwt || json?.data?.accessToken;",
                  "pm.test('Token exists in response', function () {",
                  "  pm.expect(token).to.not.be.undefined;",
                  "  pm.expect(token).to.not.equal('');",
                  "});",
                  "if (token) {",
                  "  pm.collectionVariables.set('token', token);",
                  "  console.log('JWT token stored');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (ADMIN) - set {{token}}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
