Optional: Use MySQL instead of default H2 in-memory DB
DB_URL=jdbc:mysql://localhost:3306/estore_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=DB_PASSWORD
DB_DRIVER=com.mysql.cj.jdbc.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# Optional: MongoDB URI
MONGO_URI=mongodb://localhost:27017/estore_reviews

# Optional: JWT settings
JWT_SECRET=YourSuperSecretKeyForJWTTokenGenerationThatIsAtLeast256BitsLong123456789
JWT_EXPIRATION=86400000
